# Copy to .env and fill in. Never commit the real .env (already in .gitignore).

# GCP project hosting BigQuery + Vertex AI. Defaults to weathernext3-route-agent if unset.
GCP_PROJECT_ID=weathernext3-route-agent

# BigQuery dataset/table for the subscribed WeatherNext 3 Analytics Hub listing.
# Placeholders until scripts/02_subscribe_analytics_hub_listing.sh has run — see
# scripts/01_discover_weathernext_listing.md for how these get filled in.
BQ_LOCATION=US
WEATHERNEXT_DATASET=weathernext3
WEATHERNEXT_TABLE=forecast

# Maps Platform API key restricted to routes.googleapis.com. Created by
# scripts/03_create_maps_routes_api_key.sh.
GOOGLE_MAPS_ROUTES_API_KEY=

# Vertex AI location for the Gemini client used by agent/loop.py (independent of this Claude
# Code session's own CLOUD_ML_REGION in .claude/settings.json).
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=1
