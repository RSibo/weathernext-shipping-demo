# Copy to .env and fill in. Never commit the real .env (already in .gitignore).

# REPLACE THIS with your own GCP project ID. There is deliberately no real-sounding default here
# (see config.py) — leaving this as the placeholder will fail obviously and immediately the moment
# you touch a real GCP service, instead of silently trying to use someone else's project.
GCP_PROJECT_ID=your-gcp-project-id

# BigQuery dataset/table for YOUR OWN subscribed WeatherNext 3 Analytics Hub listing (WeatherNext 3
# access is allowlist-gated via Google's Data Request form — see the README and
# scripts/01_discover_weathernext_listing.md before assuming this is a quick setup step). The
# values below are the real, confirmed table name/schema shape once you have access — the dataset
# name itself (`weathernext_3` here) is whatever *you* name it when you subscribe.
BQ_LOCATION=US
WEATHERNEXT_DATASET=weathernext_3
WEATHERNEXT_TABLE=weathernext_3_0_0_0p1deg

# How far back to search for a fresh forecast init (NOT the forecast horizon — a single init
# already reaches 360h into the future on its own). Inits occur at minimum every 6h, so this is
# about safety margin, not coverage. This used to be hardcoded as 16 days, which was both
# conceptually wrong and the actual cause of a real, measured 8.19TB ($51) query — confirmed live,
# the identical query costs 363GB ($2.27) at 24h and 61GB ($0.38) at 12h. 24h chosen for margin.
WEATHERNEXT_INIT_LOOKBACK_HOURS=24

# Safety cap so a malformed query or a misconfigured lookback window fails loudly and for free
# instead of silently billing an unbounded amount — sized with generous headroom above the real
# measured cost at the default lookback above (~350-900GB for shipments up to 5 waypoints; cost is
# dominated by the lookback window's width, not waypoint count). Results are also cached for
# WEATHERNEXT_CACHE_TTL_SECONDS (default 1h, matching the forecast update cadence).
WEATHERNEXT_MAX_BYTES_BILLED=2199023255552
WEATHERNEXT_CACHE_TTL_SECONDS=3600

# Maps Platform API key restricted to routes.googleapis.com. Created by
# scripts/03_create_maps_routes_api_key.sh.
GOOGLE_MAPS_ROUTES_API_KEY=

# Vertex AI location for the Gemini client this app uses (agent/runner.py). Requires the identity
# running this (gcloud application-default credentials or a service account) to have the
# Vertex AI User role on GCP_PROJECT_ID.
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_GENAI_USE_VERTEXAI=1

# Showcase web app. Browser Maps key: restrict to your referrers AND to "Maps JavaScript API"
# (scripts/deploy.sh does both for the Cloud Run URL). MAP_ID: a styled vector Map ID; empty uses
# Google's DEMO_MAP_ID in the dark colour scheme.
MAPS_JS_API_KEY=
MAP_ID=

# Optional public-URL guards (per instance). Past the daily cap, runs are served from data/golden/.
# MAX_CONCURRENT_RUNS=4
# DAILY_LIVE_RUN_CAP=300
